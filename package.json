{
  "name": "next-chessground",
  "version": "2.0.0",
  "description": "Declarative React chessboard on lichess chessground: legal moves, promotion, premoves, variants, themes",
  "type": "module",
  "license": "GPL-3.0",
  "author": "victorocna <victor@chesscoders.com>",
  "homepage": "https://github.com/victorocna/next-chessground",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorocna/next-chessground.git"
  },
  "keywords": [
    "chess",
    "chessboard",
    "chessground",
    "react",
    "chessops"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": ["dist"],
  "sideEffects": [
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./pieces.css": "./dist/pieces.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && npm run build:css",
    "build:css": "echo '/* next-chessground: chessground base stylesheet, board themes, coordinates, highlights, promotion, controls, settings */' > dist/styles.css && cat node_modules/@lichess-org/chessground/assets/chessground.base.css src/css/root.css src/css/highlights.css src/css/board.css src/css/coords.css src/css/promotion.css src/css/controls.css src/css/settings.css >> dist/styles.css && cp src/css/pieces.css dist/pieces.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "chessops": "^0.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^5.0.0"
  }
}
